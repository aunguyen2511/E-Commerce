@model IEnumerable<CartItem>
<link href="~/css/HangHoa.css" />

@{
    ViewData["Title"] = "PaypalDemo";
}

<h1>Paypal Demo</h1>

<h1>Thông tin thanh toán</h1>

<div class="cart-table table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th class="pro-thumbnail">Thumbnail</th>
                <th class="pro-title">Product</th>
                <th class="pro-price">Price</th>
                <th class="pro-quantity">Quantity</th>
                <th class="pro-subtotal">Total</th>
                <th class="pro-remove">Remove</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="HangHoas" asp-action="Details" asp-route-id="@item.MaHh">
                            <img src="~/Hinh/HangHoa/@item.Hinh" alt="@item.TenHh" height="100px;" />
                        </a>
                    </td>
                    <td>@item.TenHh</td>
                    <td>@item.DonGia</td>
                    <td>
                        <input value="@item.SoLuong" min="1" type="number" class="so-luong-mua" onchange="updateQuantity(@item.MaHh, this.value)" />
                    </td>
                    <td>@item.ThanhTien.ToString("#,##0.00")</td>
                    <td>
                        <a class="btn btn-danger" asp-action="RemoveCartItem" asp-route-id="@item.MaHh">
                            Xoá
                        </a>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>



<div>
    <div id="paypal-button-container" style="max-width:200px;"></div>
    @section Scripts {
        <script src="https://www.paypal.com/sdk/js?client-id=@ViewBag.PaypalClientId"></script>
        <!-- b. Tinh chỉnh các sự kiện tạo order và capture order (2 actions cuối trong PaymentController) -->
        <script>
            paypal.Buttons({
                style: {
                    disableMaxWidth: true // hả ???????????????
                },
                createOrder: (data, actions) => {
                    return fetch("/Payment/PaypalOrder", {
                        method: "post",
                    }).then((response) => {
                        if (!response.ok) {
                            return response.json().then(error => { throw error; });
                        }

                        return response.json();
                    }).then((order) => order.id)
                        .catch(error => alert(error.message));
                },
                onApprove: (data, actions) => {
                    return fetch(`/Payment/PaypalCapture?orderId=${data.orderID}`, {
                        method: "post",
                    }).then((response) => {
                        if (!response.ok) {
                            return response.json().then(error => { throw error; });
                        }
                        console.log(response);

                        //Đổi địa chỉ tới action thông báo thành công
                        window.location.href = "/Payment/Success";
                    }).catch(error => alert(error.message));
                }
            }).render('#paypal-button-container');
        </script>
    }
</div>



