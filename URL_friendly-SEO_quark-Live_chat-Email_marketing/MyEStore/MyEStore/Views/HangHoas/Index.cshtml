@model IEnumerable<MyEStore.Models.HangHoaVM>

@{
    ViewData["Title"] = "Index";
}

<h1>Danh sách Hàng hoá</h1>

<link href="~/css/HangHoa.css" rel="stylesheet" />

<p>
    <a asp-action="Create">Create New</a>
</p>

<div class="container">
    @foreach(var hh in Model)
    {
        <div class="hh-box">
            <h3 class="hh-box-name">@hh.TenHh</h3>

            <!-- chỗ này config sao cho lúc bấm vô hình thì nó nhảy qua trang details của sản phẩm mới bấm nè -->
            
            @* <a asp-action="Details" asp-route-id="@hh.MaHh"><img src="~/Hinh/HangHoa/@hh.Hinh" alt="@hh.TenHh" class="hh-box-img" /></a> *@
            <a href="~/san-pham/@hh.TenAlias">
                <img src="~/Hinh//HangHoa/@hh.Hinh" alt="@hh.TenHh" class="hh-box-img" />
            </a>

            <div class="hh-box-price">$ @hh.DonGia</div>
            <a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@hh.MaHh" class="btn btn-primary hh-box-mua">MUA</a>
        </div>
    }
</div>